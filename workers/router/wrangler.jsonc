{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "react-canary-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CONTROL_URL": "http://localhost:8787",
    "TREATMENT_URL": "http://localhost:8788",
    "SPLIT_PERCENT": "50"
  },
  "kv_namespaces": [{ "binding": "METRICS", "id": "REPLACE_WITH_KV_ID" }]
}
